# Copy to .env and edit. No personal data is committed — only this example.
RUMINATE_PORT=8000
RUMINATE_DATA_DIR=./data
RUMINATE_MEDIA_DIR=./media

# Polling: on_open | periodic | instant
# - on_open: NAS only checks when the app opens (POST /api/subscriptions/refresh)
# - periodic: background loop every RUMINATE_POLL_INTERVAL_MINUTES
# - instant: tight loop clamped to >=5 min for near-instant grabs
RUMINATE_POLL_MODE=periodic
RUMINATE_POLL_INTERVAL_MINUTES=30

RUMINATE_MAX_RESOLUTION=1080
RUMINATE_SPONSORBLOCK_REMOVE=sponsor,selfpromo,interaction
RUMINATE_SPONSORBLOCK_MARK=all
RUMINATE_KEEP_DAYS=0
