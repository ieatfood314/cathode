# Copy to .env and edit. No personal data is committed — only this example.
CATHODE_PORT=8000
CATHODE_DATA_DIR=./data
CATHODE_MEDIA_DIR=./media

# Polling: on_open | periodic | instant
# - on_open: NAS only checks when the app opens (POST /api/subscriptions/refresh)
# - periodic: background loop every CATHODE_POLL_INTERVAL_MINUTES
# - instant: tight loop clamped to >=5 min for near-instant grabs
CATHODE_POLL_MODE=periodic
CATHODE_POLL_INTERVAL_MINUTES=30

CATHODE_MAX_RESOLUTION=1080
CATHODE_SPONSORBLOCK_REMOVE=sponsor,selfpromo,interaction
CATHODE_SPONSORBLOCK_MARK=all
CATHODE_KEEP_DAYS=0
